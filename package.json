{
  "name": "bws-architecture-client-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "worker:dev": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "lint": "eslint src worker --ext .js,.jsx,.ts,.tsx,.astro --quiet",
    "lint:full": "eslint src worker --ext .js,.jsx,.ts,.tsx,.astro",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@marsidev/react-turnstile": "^1.5.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "7.1.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.42.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/bun": "^1.3.12",
    "@vitejs/plugin-react": "5.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "wrangler": "^4.0.0"
  }
}
