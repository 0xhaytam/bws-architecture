{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bws-architecture",
  "main": "./worker/index.ts",
  "tsconfig": "./tsconfig.worker.json",
  "compatibility_date": "2026-07-29",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/forms/*"]
  },
  "preview_urls": false,
  "vars": {
    "PUBLIC_SITE_URL": "https://bws-architecture.com",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFd_Fwn6awR3rhcv",
    "WP_CMS_URL": "https://cms.bws-architecture.com",
    "WP_MEDIA_DOMAIN": "media.bws-architecture.com"
  }
}